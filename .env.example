# On Ubuntu, bind to the server's Tailscale address, never 0.0.0.0.
VIRTUALINK_BIND_ADDRESS=100.79.187.62
# false is appropriate for this host's private Tailscale HTTP address. Set to
# true when the service is behind an HTTPS reverse proxy or custom domain.
VIRTUALINK_SECURE_COOKIE=false

# Generate separate long random values. Do not commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-value
VIRTUALINK_AUTH_SECRET=replace-with-a-long-random-value
